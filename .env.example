# Copy and supply your local database password. Never commit .env.
DATABASE_URL=postgres://taskflow:CHANGE_ME@127.0.0.1:5432/taskflow?sslmode=disable
TASKFLOW_HTTP_ADDR=127.0.0.1:9090

# Local-only example; existing volumes retain their current password.
POSTGRES_PASSWORD=CHANGE_ME
TASKFLOW_ENV=development
# Production: exact https origin, trusted TLS terminator CIDRs, verify-full DB TLS.
# TASKFLOW_PUBLIC_ORIGIN=https://tasks.example.com
# TASKFLOW_TRUSTED_PROXIES=127.0.0.1/32,::1/128
