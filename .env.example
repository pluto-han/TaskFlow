# Copy and supply your local database password. Never commit .env.
DATABASE_URL=postgres://taskflow:CHANGE_ME@127.0.0.1:5432/taskflow?sslmode=disable
TASKFLOW_HTTP_ADDR=127.0.0.1:9090

# Local-only example; existing volumes retain their current password.
POSTGRES_PASSWORD=CHANGE_ME
TASKFLOW_ENV=development
# Production: exact https origin, trusted TLS terminator CIDRs, verify-full DB TLS.
# TASKFLOW_PUBLIC_ORIGIN=https://tasks.example.com
# TASKFLOW_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Opt in only after schema 11 and runtime grants are installed.
# One background DB connection; batches of 20, 30s normal scan interval.
TASKFLOW_RECURRENCE_ENABLED=false

# Public application identifiers; both empty disables Discord binding.
# Public key is the 64-character hex key from Developer Portal, NOT a bot token.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot token is only needed by the manual registration tool in this lesson:
# DISCORD_BOT_TOKEN_FILE=/absolute/private/path/bot-token

# Explicit opt-in: requires DISCORD_BOT_TOKEN_FILE; no messages when false.
TASKFLOW_DISCORD_SENDER_ENABLED=false

# Optional Today cache. Keep off in production until write invalidation is complete.
TASKFLOW_CACHE_ENABLED=false
# Redis lives on a private Docker network; these are container-side examples.
# REDIS_ADDR=redis:6379
# REDIS_USERNAME=taskflow_cache
# REDIS_PASSWORD_FILE=/run/secrets/redis_password
