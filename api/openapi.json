{
  "openapi": "3.0.3",
  "info": {
    "title": "TaskFlow API",
    "version": "1.0.0",
    "description": "All errors use {error:{code,message}}; clients branch on stable code, not message. Server-generated X-Request-ID accompanies responses. Unknown routes: 404 ROUTE_NOT_FOUND; unsupported methods on known routes: 405 METHOD_NOT_ALLOWED. Validation stays 400 (422 not used); owner-only resources conceal unauthorized existence with 404 (403 not used). Auth credentials must be transported over HTTPS outside loopback development. Auth/task/project bodies are never logged. Task/project oversized bodies currently return 400; auth oversized bodies return 413. No frontend or cookie authentication in this lesson. Paths are exact: no automatic trailing-slash redirects."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:9090",
      "description": "Local development; use the configured HTTP address."
    }
  ],
  "security": [
    {
      "bearerSession": []
    }
  ],
  "paths": {
