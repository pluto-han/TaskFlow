    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "listTasks",
        "description": "Own tasks only; ordered by created_at DESC, id DESC. Array response, not an envelope. X-Next-Cursor is omitted on the last page. Known parameters reject duplicates/empty values; unknown parameters are ignored. Cursor is scoped to user and filters; it is not a snapshot, concurrent edits may affect results.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated opaque correlation ID; incoming values are ignored.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Next-Cursor": {
                "schema": {
                  "type": "string"
                },
                "description": "Opaque cursor for next page, omitted when exhausted."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "504": {
            "$ref": "#/components/responses/Error504"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Page size."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Opaque X-Next-Cursor from previous response; keep the same filters and user."
          },
          {
            "name": "completed",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Literal true/false."
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "description": "Priority filter."
          },
          {
            "name": "has_due_date",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Literal true/false; false cannot be combined with due ranges."
          },
          {
            "name": "due_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Inclusive due date lower bound."
          },
          {
            "name": "due_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Exclusive upper bound; must be greater than due_from."
          },
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Project UUID, or literal none for unclassified tasks. Omit for all own tasks. Invalid/empty/duplicate values return 400. Foreign or absent projects yield an empty array. Cursor is bound to this filter."
          }
        ]
      },
