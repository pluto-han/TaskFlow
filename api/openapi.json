  "components": {
    "securitySchemes": {
      "bearerSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque session token"
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "AUTH_BUSY",
              "EMAIL_ALREADY_EXISTS",
              "INTERNAL_ERROR",
              "INVALID_PROJECT",
              "INVALID_QUERY",
              "INVALID_REQUEST",
              "INVALID_TASK",
              "INVALID_USER",
              "LOGIN_RATE_LIMITED",
              "METHOD_NOT_ALLOWED",
